{
  "name": "flowforge",
  "version": "1.0.0",
  "description": "FlowForge - Engineering Workflow & Issue Management Platform",
  "type": "module",
  "scripts": {
    "dev": "node run-dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test:server": "node server/test-server.js",
    "seed": "node server/seed.js",
    "build:client": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "fsd",
    "react",
    "express",
    "mongodb",
    "redux-toolkit",
    "jwt",
    "tailwind"
  ]
}
